# Backend API base URL, including the /api/v1/ prefix. Baked into the app at build time.
# Android emulator -> your machine's localhost: http://10.0.2.2:3000/api/v1/
# Physical phone on the same Wi-Fi: http://<your-LAN-IP>:3000/api/v1/
# For the delivered APK use the deployed HTTPS backend URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1/
